{
  "name": "@endosome/ghost-cursor",
  "version": "1.5.0",
  "description": "Move your mouse like a human in puppeteer or playwright, or generate realistic movements on any 2D plane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endosome/ghost-cursor.git"
  },
  "bugs": {
    "url": "https://github.com/endosome/ghost-cursor/issues"
  },
  "homepage": "https://github.com/endosome/ghost-cursor#readme",
  "main": "lib/spoof.js",
  "types": "lib/spoof.d.ts",
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json && husky",
    "build": "tsc -p tsconfig.build.json",
    "debug": "ts-node src/__debug__/browser-debug.ts",
    "lint": "yarn ts-standard --fix",
    "test": "jest",
    "validate": "yarn lint && yarn build"
  },
  "keywords": [
    "bezier-curve",
    "mouse-movement",
    "botting",
    "puppeteer",
    "playwright"
  ],
  "author": "Xetera",
  "contributors": [
    "endosome (https://github.com/endosome)"
  ],
  "license": "ISC",
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@types/bezier-js": "^4.1.3",
    "bezier-js": "^6.1.4",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-puppeteer": "^11.0.0",
    "playwright-core": "^1.65.1",
    "puppeteer": "^25.4.0",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typescript": "6"
  },
  "peerDependencies": {
    "playwright-core": ">=1.20",
    "puppeteer": ">=14"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "resolutions": {
    "jest-environment-node": "30.4.1"
  },
  "jest": {
    "verbose": true,
    "preset": "jest-puppeteer",
    "modulePathIgnorePatterns": [
      "./lib",
      "./src/test.ts"
    ],
    "reporters": [
      "default",
      "github-actions"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "@swc/jest"
    }
  },
  "packageManager": "yarn@4.18.0"
}
